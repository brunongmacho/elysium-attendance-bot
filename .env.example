# ELYSIUM Guild Bot - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: Discord Bot Token
# ============================================================================
# Get this from Discord Developer Portal (https://discord.com/developers/applications)
# 1. Create/select your application
# 2. Go to "Bot" section
# 3. Click "Reset Token" and copy the token
DISCORD_TOKEN=your_discord_bot_token_here

# ============================================================================
# OPTIONAL: HTTP Server Port
# ============================================================================
# Port for the health check HTTP server (default: 3000)
# Koyeb and other platforms use this for health checks
PORT=3000

# ============================================================================
# OPTIONAL: Node Environment
# ============================================================================
# Set to "production" for deployed environments (automatically set in Dockerfile)
# Set to "development" for local testing
NODE_ENV=production

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Structured logging with Pino (see utils/logger.js)
# Options: debug, info, warn, error
# Default: info in production, debug in development
LOG_LEVEL=info

# Legacy log configuration (will be phased out)
LOG_STARTUP=false                      # Enable verbose startup logs
LOG_PROACTIVE=false                    # Enable proactive intelligence logs
LOG_NLP=false                          # Enable NLP learning logs
LOG_RECOVERY=false                     # Enable recovery system logs
LOG_INTELLIGENCE=false                 # Enable intelligence engine logs

# ============================================================================
# METRICS & PROMETHEUS
# ============================================================================
# Prometheus metrics server configuration
# Metrics available at http://localhost:9090/metrics
METRICS_PORT=9090                      # Port for metrics endpoint (default: 9090)
METRICS_HOST=0.0.0.0                   # Host for metrics server (default: 0.0.0.0)

# ============================================================================
# SENTRY ERROR TRACKING & APM
# ============================================================================
# Application Performance Monitoring and Error Tracking
# Get your DSN from https://sentry.io/settings/projects/
SENTRY_DSN=                            # Your Sentry DSN (optional, leave empty to disable)
SENTRY_ENABLED=true                    # Enable/disable Sentry (default: true if DSN is set)

# Performance monitoring configuration
# Sample rates control what percentage of transactions are sent to Sentry
# Lower values = less overhead, less visibility
# Higher values = more overhead, better visibility
SENTRY_TRACES_SAMPLE_RATE=0.1         # 10% of transactions (default: 0.1)
SENTRY_PROFILES_SAMPLE_RATE=0.1       # 10% of profiling samples (default: 0.1)

# ============================================================================
# GRACEFUL DEGRADATION
# ============================================================================
# Operation queue and circuit breaker configuration
# Handles service outages gracefully with automatic retry
MAX_QUEUE_SIZE=1000                    # Maximum queued operations (default: 1000)
MAX_OPERATION_RETRIES=5                # Max retries per failed operation (default: 5)

# ============================================================================
# MONGODB CONFIGURATION (Phase 4+)
# ============================================================================
# MongoDB Atlas connection string and feature flags
# Get your connection string from MongoDB Atlas (https://cloud.mongodb.com)
MONGODB_URI=                           # Your MongoDB connection string (required for Phase 4+)

# Feature flags to enable MongoDB for specific systems
USE_MONGODB_BIDDING=true               # Enable MongoDB for bidding/auction operations (Phase 4)
USE_MONGODB_ATTENDANCE=true            # Enable MongoDB for attendance tracking (Phase 4.5)

# Startup optimization flags
SKIP_ATTENDANCE_SYNC=false             # Set to 'true' to skip attendance sync on startup (saves ~10-20s)
SKIP_BACKGROUND_SYNC=false             # Set to 'true' to skip background sync entirely (use with startup-fast.js)

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# For Koyeb deployment (FAST STARTUP RECOMMENDED):
# 1. Do NOT commit .env to git (already in .gitignore)
# 2. Add DISCORD_TOKEN as a secret in Koyeb dashboard
# 3. Set memory limit to 512MB
# 4. Set port to 3000 for health checks
# 5. Ensure config.json is properly configured with Discord IDs
# 6. Use "npm run start:fast" for 10-30 second faster startup
#    OR set SKIP_ATTENDANCE_SYNC=true to speed up regular startup
#
# Startup options (ranked by speed):
# - npm run start:fast (FASTEST - recommended for production)
#   Bot starts immediately, sync runs in background
# - npm start with SKIP_ATTENDANCE_SYNC=true (FAST)
#   Skips attendance sync, only syncs members/items/rotation
# - npm start (SLOWER - thorough)
#   Full sync before bot starts, safer but slower
#
# For local development:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual tokens
# 3. Run: npm run start:fast (or npm start for full sync)
# 4. Monitor health endpoint: http://localhost:3000/health
