{
  "name": "guild-attendance-bot",
  "version": "9.0.0",
  "description": "Boss attendance + points bot for ELYSIUM guild",
  "main": "index2.js",
  "scripts": {
    "start": "node scripts/startup.js",
    "start:direct": "node --expose-gc --max-old-space-size=512 --optimize-for-size --max-semi-space-size=8 index2.js",
    "sync": "node scripts/sync-sheets-to-mongodb.js",
    "deploy": "clasp push",
    "deploy:new": "clasp deploy --description \"Deployment $(date +'%Y-%m-%d %H:%M:%S')\"",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "discord.js": "^14.25.1",
    "fast-levenshtein": "^3.0.0",
    "mongodb": "^6.21.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!Code.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
